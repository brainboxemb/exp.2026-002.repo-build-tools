# Candidate-specific translation of fixture/capability-model.json.
# This is experiment configuration, not a proposed production BUILD model.

files(
    name="global_inputs",
    sources=["project.json", "tools/**", ".github/workflows/**"],
)

files(name="product_source", sources=["src/product/**"])
files(name="product_config", sources=["config/product.json"])
files(name="test_inputs", sources=["tests/**"])
files(name="verification_config", sources=["config/verification.json"])
files(name="docs_diagram_inputs", sources=["docs/_diagrams/**", "docs/_diagram-theme/**"])
files(name="docs_authored_inputs", sources=["docs/**/*.md"])
files(name="publication_inputs", sources=["release/**"])
files(name="unrelated_readme", sources=["README.md"])

target(
    name="repository_validate_cap",
    dependencies=[":global_inputs"],
    tags=["capability", "cap:repository.validate"],
)

target(
    name="product_build_cap",
    dependencies=[":global_inputs", ":product_source", ":product_config"],
    tags=["capability", "cap:product.build"],
)

target(
    name="verification_cap",
    dependencies=[":global_inputs", ":product_source", ":test_inputs", ":verification_config"],
    tags=["capability", "cap:verification"],
)

target(
    name="docs_diagrams_cap",
    dependencies=[":global_inputs", ":docs_diagram_inputs"],
    tags=["capability", "cap:docs.diagrams"],
)

target(
    name="docs_assemble_cap",
    dependencies=[":global_inputs", ":docs_authored_inputs", ":docs_diagrams_cap"],
    tags=["capability", "cap:docs.assemble"],
)

target(
    name="publication_cap",
    dependencies=[
        ":global_inputs",
        ":publication_inputs",
        ":product_build_cap",
        ":verification_cap",
        ":docs_assemble_cap",
    ],
    tags=["capability", "cap:publication"],
)
