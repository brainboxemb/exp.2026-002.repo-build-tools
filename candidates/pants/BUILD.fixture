# Candidate-specific translation of fixture/capability-model.json.
# This is experiment configuration, not a proposed production BUILD model.
#
# Each logical capability directly owns the source selectors that should impact
# it. Only real producer/consumer relationships are expressed as dependencies.

repo_capability(
    name="repository_validate_cap",
    sources=["project.json", "tools/**", ".github/workflows/**"],
    tags=["capability", "cap:repository.validate"],
)

repo_capability(
    name="product_build_cap",
    sources=[
        "project.json",
        "tools/**",
        ".github/workflows/**",
        "src/product/**",
        "config/product.json",
    ],
    tags=["capability", "cap:product.build"],
)

repo_capability(
    name="verification_cap",
    sources=[
        "project.json",
        "tools/**",
        ".github/workflows/**",
        "src/product/**",
        "tests/**",
        "config/verification.json",
    ],
    tags=["capability", "cap:verification"],
)

repo_capability(
    name="docs_diagrams_cap",
    sources=[
        "project.json",
        "tools/**",
        ".github/workflows/**",
        "docs/_diagrams/**",
        "docs/_diagram-theme/**",
    ],
    tags=["capability", "cap:docs.diagrams"],
)

repo_capability(
    name="docs_assemble_cap",
    sources=[
        "project.json",
        "tools/**",
        ".github/workflows/**",
        "docs/**/*.md",
    ],
    dependencies=[":docs_diagrams_cap"],
    tags=["capability", "cap:docs.assemble"],
)

repo_capability(
    name="publication_cap",
    sources=[
        "project.json",
        "tools/**",
        ".github/workflows/**",
        "release/**",
    ],
    dependencies=[
        ":product_build_cap",
        ":verification_cap",
        ":docs_assemble_cap",
    ],
    tags=["capability", "cap:publication"],
)
